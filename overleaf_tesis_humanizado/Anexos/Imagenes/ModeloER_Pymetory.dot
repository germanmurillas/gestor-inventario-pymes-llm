digraph ER {
 graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.9, concentrate=false, fontname="Helvetica"];
 node [shape=plain, fontname="Helvetica", fontsize=10];
 edge [arrowhead=crow, arrowtail=none, color="#555555"];
 users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>users</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="name">      name</td></tr><tr><td align="left" port="email">      email</td></tr><tr><td align="left" port="role">      role</td></tr></table>>];
 bodegas [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>bodegas</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="name">      name</td></tr><tr><td align="left" port="code">      code</td></tr><tr><td align="left" port="description">      description</td></tr><tr><td align="left" port="capacity">      capacity</td></tr><tr><td align="left" port="status">      status</td></tr><tr><td align="left" port="image_path">      image_path</td></tr></table>>];
 materials [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>materials</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="code">      code</td></tr><tr><td align="left" port="name">      name</td></tr><tr><td align="left" port="unit">      unit</td></tr><tr><td align="left" port="description">      description</td></tr><tr><td align="left" port="stock_min">      stock_min</td></tr><tr><td align="left" port="stock_max">      stock_max</td></tr><tr><td align="left" port="unidad_medida">      unidad_medida</td></tr><tr><td align="left" port="categoria">      categoria</td></tr><tr><td align="left" port="stock_minimo">      stock_minimo</td></tr><tr><td align="left" port="photo_path">      photo_path</td></tr><tr><td align="left" port="custom_fields">      custom_fields</td></tr></table>>];
 lotes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>lotes</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="material_id">FK  material_id</td></tr><tr><td align="left" port="batch_number">      batch_number</td></tr><tr><td align="left" port="quantity">      quantity</td></tr><tr><td align="left" port="expiration_date">      expiration_date</td></tr><tr><td align="left" port="status">      status</td></tr><tr><td align="left" port="bodega_id">FK  bodega_id</td></tr><tr><td align="left" port="unit_cost">      unit_cost</td></tr><tr><td align="left" port="photo_path">      photo_path</td></tr></table>>];
 movimientos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#7c2d12"><font color="white"><b>movimientos</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="lote_id">FK  lote_id</td></tr><tr><td align="left" port="user_id">FK  user_id</td></tr><tr><td align="left" port="type">      type</td></tr><tr><td align="left" port="quantity">      quantity</td></tr><tr><td align="left" port="reason">      reason</td></tr><tr><td align="left" port="description">      description</td></tr></table>>];
 transferencias [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>transferencias</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="from_bodega_id">FK  from_bodega_id</td></tr><tr><td align="left" port="to_bodega_id">FK  to_bodega_id</td></tr><tr><td align="left" port="lote_id">FK  lote_id</td></tr><tr><td align="left" port="cantidad">      cantidad</td></tr><tr><td align="left" port="user_id">FK  user_id</td></tr><tr><td align="left" port="reason">      reason</td></tr></table>>];
 tags [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>tags</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="nombre">      nombre</td></tr><tr><td align="left" port="color">      color</td></tr><tr><td align="left" port="icono">      icono</td></tr><tr><td align="left" port="descripcion">      descripcion</td></tr><tr><td align="left" port="active">      active</td></tr></table>>];
 material_tag [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>material_tag</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="material_id">FK  material_id</td></tr><tr><td align="left" port="tag_id">FK  tag_id</td></tr></table>>];
 vendors [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>vendors</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="name">      name</td></tr><tr><td align="left" port="contact_name">      contact_name</td></tr><tr><td align="left" port="email">      email</td></tr><tr><td align="left" port="phone">      phone</td></tr><tr><td align="left" port="address">      address</td></tr><tr><td align="left" port="notes">      notes</td></tr></table>>];
 purchase_orders [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>purchase_orders</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="po_number">      po_number</td></tr><tr><td align="left" port="status">      status</td></tr><tr><td align="left" port="vendor_id">FK  vendor_id</td></tr><tr><td align="left" port="created_by">FK  created_by</td></tr><tr><td align="left" port="submitted_by">      submitted_by</td></tr><tr><td align="left" port="date_expected">      date_expected</td></tr><tr><td align="left" port="approved_by">      approved_by</td></tr><tr><td align="left" port="ship_to">      ship_to</td></tr><tr><td align="left" port="bill_to">      bill_to</td></tr><tr><td align="left" port="notes">      notes</td></tr><tr><td align="left" port="total_cost">      total_cost</td></tr></table>>];
 purchase_order_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>purchase_order_items</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="purchase_order_id">FK  purchase_order_id</td></tr><tr><td align="left" port="material_id">FK  material_id</td></tr><tr><td align="left" port="quantity">      quantity</td></tr><tr><td align="left" port="unit_cost">      unit_cost</td></tr><tr><td align="left" port="received_qty">      received_qty</td></tr></table>>];
 audit_log [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>audit_log</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="user_id">FK  user_id</td></tr><tr><td align="left" port="accion">      accion</td></tr><tr><td align="left" port="modulo">      modulo</td></tr><tr><td align="left" port="entidad_id">      entidad_id</td></tr><tr><td align="left" port="entidad_tipo">      entidad_tipo</td></tr><tr><td align="left" port="datos_anteriores">      datos_anteriores</td></tr><tr><td align="left" port="datos_nuevos">      datos_nuevos</td></tr><tr><td align="left" port="ip_address">      ip_address</td></tr><tr><td align="left" port="user_agent">      user_agent</td></tr><tr><td align="left" port="observacion">      observacion</td></tr></table>>];
 notifications [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>notifications</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="user_id">FK  user_id</td></tr><tr><td align="left" port="tipo">      tipo</td></tr><tr><td align="left" port="titulo">      titulo</td></tr><tr><td align="left" port="mensaje">      mensaje</td></tr><tr><td align="left" port="accion_url">      accion_url</td></tr><tr><td align="left" port="icono">      icono</td></tr><tr><td align="left" port="leida">      leida</td></tr><tr><td align="left" port="leida_at">      leida_at</td></tr></table>>];
 chat_histories [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>chat_histories</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="user_id">FK  user_id</td></tr><tr><td align="left" port="prompt">      prompt</td></tr><tr><td align="left" port="response">      response</td></tr><tr><td align="left" port="source">      source</td></tr><tr><td align="left" port="session_id">      session_id</td></tr><tr><td align="left" port="session_title">      session_title</td></tr></table>>];
 kanban_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1e1b4b"><font color="white"><b>kanban_items</b></font></td></tr><tr><td align="left" port="id">PK  id</td></tr><tr><td align="left" port="user_id">FK  user_id</td></tr><tr><td align="left" port="title">      title</td></tr><tr><td align="left" port="description">      description</td></tr><tr><td align="left" port="column">      column</td></tr><tr><td align="left" port="position">      position</td></tr><tr><td align="left" port="is_pinned">      is_pinned</td></tr><tr><td align="left" port="rag_context">      rag_context</td></tr></table>>];
 bodegas -> lotes [xlabel=" bodega_id ", fontsize=8, fontcolor="#444444"];
 materials -> lotes [xlabel=" material_id ", fontsize=8, fontcolor="#444444"];
 users -> movimientos [xlabel=" user_id ", fontsize=8, fontcolor="#444444"];
 lotes -> movimientos [xlabel=" lote_id ", fontsize=8, fontcolor="#444444"];
 users -> transferencias [xlabel=" user_id ", fontsize=8, fontcolor="#444444"];
 lotes -> transferencias [xlabel=" lote_id ", fontsize=8, fontcolor="#444444"];
 bodegas -> transferencias [xlabel=" to_bodega_id ", fontsize=8, fontcolor="#444444"];
 bodegas -> transferencias [xlabel=" from_bodega_id ", fontsize=8, fontcolor="#444444"];
 tags -> material_tag [xlabel=" tag_id ", fontsize=8, fontcolor="#444444"];
 materials -> material_tag [xlabel=" material_id ", fontsize=8, fontcolor="#444444"];
 users -> purchase_orders [xlabel=" created_by ", fontsize=8, fontcolor="#444444"];
 vendors -> purchase_orders [xlabel=" vendor_id ", fontsize=8, fontcolor="#444444"];
 materials -> purchase_order_items [xlabel=" material_id ", fontsize=8, fontcolor="#444444"];
 purchase_orders -> purchase_order_items [xlabel=" purchase_order_id ", fontsize=8, fontcolor="#444444"];
 users -> audit_log [xlabel=" user_id ", fontsize=8, fontcolor="#444444"];
 users -> notifications [xlabel=" user_id ", fontsize=8, fontcolor="#444444"];
 users -> chat_histories [xlabel=" user_id ", fontsize=8, fontcolor="#444444"];
 users -> kanban_items [xlabel=" user_id ", fontsize=8, fontcolor="#444444"];
}
